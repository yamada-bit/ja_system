SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=*
# 最小権限の原則：postgresスーパーユーザーではなく、ja_db専用ロールja_appを使う。
DATABASE_URL=postgres://ja_app:change-me@localhost:5432/ja_db
MAX_UPLOAD_SIZE_BYTES=52428800
CHUNK_UPLOAD_MAX_SIZE_BYTES=524288000
# tmp_uploads/配下の放置ファイル・チャンク断片を孤児とみなす経過時間（時間単位、既定24）。
# core.management.commands.cleanup_temp_uploadsが使う（config/settings/base.py参照）。
# STALE_TMP_UPLOAD_THRESHOLD_HOURS=24

# --- メイン画面「お知らせ」しきい値・契約書保存期限（xlsx メイン画面!B36,B38,B48）---
# 先方から変更依頼を受けた際、コードを変更せずここを書き換えるだけで反映できる（config/settings/base.py参照）。
# 有効期限切れまでXヵ月以内、のXヵ月。既定1ヵ月。
# NOTICE_EXPIRING_THRESHOLD_MONTHS=1
# 直近Xヵ月内で削除された、のXヵ月。既定1ヵ月。
# NOTICE_DELETED_THRESHOLD_MONTHS=1
# 契約書の保存期限（年）固定値。既定10年。
# CONTRACT_RETENTION_YEARS=10

# --- 全文検索：スキャンPDFのOCR（Google Cloud Vision）---
# 既定True。Falseにするとスキャン文書（テキスト層の無いPDF）は全文検索の対象外のまま据え置かれる
# （config/settings/base.py参照）。
# OCR_ENABLED=False
# サービスアカウント鍵（JSON）のファイルパス。
# GOOGLE_APPLICATION_CREDENTIALS=C:\ja_system\secrets\gcp-vision-key.json
# pdf2image（OCRがPDFをページ画像化するのに使う）が依存するpopplerバイナリのディレクトリパス。
# OSのPATHが通っている環境では設定不要。
# POPPLER_PATH=C:\poppler\Library\bin
# OCR結果を透明テキストとして埋め込んだ検索用PDF（documents.Document/contracts.Contractの
# searchable_file）を生成するかどうか。既定False（config/settings/base.py参照）。
# OCR_EMBED_TEXT_TO_PDF=True

# --- 本番運用向け設定（config/settings/prod.py、DJANGO_SETTINGS_MODULE=config.settings.prod時のみ）---
# 500エラー（未処理例外）発生時のメール通知先。カンマ区切りで複数指定可（django-environ env.list）。
# 未設定（空リスト）の間はAdminEmailHandlerが早期returnし何もしない。
# ADMIN_EMAILS=admin@example.jp
# SERVER_EMAIL=root@example.jp
# EMAIL_HOST=smtp.example.jp
# EMAIL_PORT=587
# EMAIL_HOST_USER=smtp-user
# EMAIL_HOST_PASSWORD=change-me
# EMAIL_USE_TLS=True
# リバースプロキシ配下でのCSRF検証用（本番の正規オリジンをカンマ区切りで指定）。未設定のままだと
# 本番からの正規POSTがCSRF検証エラーになるため、prod環境では必須。
# CSRF_TRUSTED_ORIGINS=https://ja-doc.example.jp
# SECURE_HSTS_SECONDS=2592000
