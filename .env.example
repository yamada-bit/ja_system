# 本番必須。未設定だと prod.py は起動時に ImproperlyConfigured で停止する（dev はフォールバック値で動作）。
# 生成例: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
# 保管・ローテーション方針は RELEASE_PREP_NOTES.md 8. 参照。
SECRET_KEY=<REQUIRED-generate-a-unique-50-char-random-key>
DEBUG=True
# 本番必須。prod.py はデフォルト無しで読み直すため、未設定だと ImproperlyConfigured で
# 起動を停止する（dev/base は "*" フォールバックで動作）。本番は実際に配信するホスト名を
# カンマ区切りで列挙する（例: ja-doc.example.jp,10.0.0.5）。ワイルドカード "*" は使わない。
ALLOWED_HOSTS=*
# 最小権限の原則：postgresスーパーユーザーではなく、ja_db専用ロールja_appを使う。
# パスワードの生成・保管・ローテーション方針は RELEASE_PREP_NOTES.md 8. 参照。
DATABASE_URL=postgres://ja_app:change-me@localhost:5432/ja_db
MAX_UPLOAD_SIZE_BYTES=52428800
CHUNK_UPLOAD_MAX_SIZE_BYTES=524288000
# チャンク分割アップロードの1チャンクあたりバイト数。既定5MB（5242880）。
# 推奨は既定のまま。大容量主体なら10MB（10485760）程度まで可。5MB未満にはしない。
# 必ず MAX_UPLOAD_SIZE_BYTES より十分小さく（20〜25MB以下）、かつ本番リバースプロキシの
# ボディサイズ上限（nginx client_max_body_size 等）がこの値＋αを許可していること
# （config/settings/base.py参照）。
CHUNK_UPLOAD_CHUNK_SIZE_BYTES=10485760
# tmp_uploads/配下の放置ファイル・チャンク断片を孤児とみなす経過時間（時間単位、既定24）。
# core.management.commands.cleanup_temp_uploadsが使う（config/settings/base.py参照）。
# STALE_TMP_UPLOAD_THRESHOLD_HOURS=24
# 保存データ（アップロードファイル）の格納先。既定はコード(ja_pj)と分離したja_system/storage/media。
# MEDIA_ROOT=C:\ja_system\storage\media
# ログ出力先。既定はコード(ja_pj)と分離したja_system/storage/logs。
# LOG_DIR=C:\ja_system\storage\logs
# 自動ログアウト時間（分）。masters.SystemSetting（DB）を正とし、DB未接続時等のフォールバックとして
# 使う既定値（config/settings/base.py参照）。既定60分。
# SESSION_IDLE_TIMEOUT_MINUTES=60

# --- メイン画面「お知らせ」しきい値・契約書保存期限（xlsx メイン画面!B36,B38,B48）---
# 先方から変更依頼を受けた際、コードを変更せずここを書き換えるだけで反映できる（config/settings/base.py参照）。
# 有効期限切れまでXヵ月以内、のXヵ月。既定1ヵ月。
# NOTICE_EXPIRING_THRESHOLD_MONTHS=1
# 直近Xヵ月内で削除された、のXヵ月。既定1ヵ月。
# NOTICE_DELETED_THRESHOLD_MONTHS=1
# 契約書の保存期限（年）固定値。既定10年。
# CONTRACT_RETENTION_YEARS=10
# 保存期間設定マスタで「永年」を選択した場合の実年数（xlsx 保存期間設定!B74）。既定50年。
# RETENTION_PERMANENT_YEARS=50
# 操作履歴ログの最大保存期間（ヵ月、xlsx 操作履歴ログ!B51-52「最大保存件数=CSV出力最大件数」）。既定3ヵ月。
# この期間より古いログは日次バッチ(purge_expired_audit_logs)で物理削除し、一覧・CSV出力からも除外する。
# AUDIT_LOG_RETENTION_MONTHS=3

# --- 全文検索：スキャンPDFのOCR（Google Cloud Vision）---
# 既定True。Falseにするとスキャン文書（テキスト層の無いPDF）は全文検索の対象外のまま据え置かれる
# （config/settings/base.py参照）。
# OCR_ENABLED=False
# サービスアカウント鍵（JSON）のファイルパス。
# 鍵の生成・保管・ローテーション方針は RELEASE_PREP_NOTES.md 8. 参照。
# GOOGLE_APPLICATION_CREDENTIALS=C:\ja_system\secrets\gcp-vision-key.json
# pdf2image（OCRがPDFをページ画像化するのに使う）が依存するpopplerバイナリのディレクトリパス。
# OSのPATHが通っている環境では設定不要。
# POPPLER_PATH=C:\poppler\Library\bin
# スキャン文書のOCR行レイアウト（座標＋テキスト）をocr_textdata（JSONField）へ保存するかどうか。
# 保存した座標データは検索用PDF（OCRテキスト埋め込み版）の遅延生成に使う。既定False
# （config/settings/base.py参照）。
# OCR_STORE_TEXTDATA=True

# --- PDFプレビューの描画方式 ---
# 既定True＝PDF.js（static/vendor/pdfjs、各ページを枠幅ぴったりのcanvasに自前描画。縦長/横長を
# 問わずフィット、遅延描画で大量ページも軽い）。Falseにすると従来のブラウザ内蔵PDFビューアの
# <iframe>方式へ戻る（狭い枠でツールバー見切れ・横長クリップの既知問題あり。config/settings/base.py参照）。
# PDF_JS_PREVIEW_ENABLED=False

# --- 本番運用向け設定（config/settings/prod.py、DJANGO_SETTINGS_MODULE=config.settings.prod時のみ）---
# 500エラー（未処理例外）発生時のメール通知先。カンマ区切りで複数指定可（django-environ env.list）。
# 未設定（空リスト）の間はAdminEmailHandlerが早期returnし何もしない。
# ADMIN_EMAILS=admin@example.jp
# SERVER_EMAIL=root@example.jp
# EMAIL_HOST=smtp.example.jp
# EMAIL_PORT=587
# EMAIL_HOST_USER=smtp-user
# EMAIL_HOST_PASSWORD=change-me
# 取得・保管・ローテーション方針は RELEASE_PREP_NOTES.md 8. 参照。
# EMAIL_USE_TLS=True
# リバースプロキシ配下でのCSRF検証用（本番の正規オリジンをカンマ区切りで指定）。未設定のままだと
# 本番からの正規POSTがCSRF検証エラーになるため、prod環境では必須。
# CSRF_TRUSTED_ORIGINS=https://ja-doc.example.jp
# SECURE_HSTS_SECONDS=2592000
# IIS/ロードバランサー等がTLSを終端し内部へは平文HTTPで転送する構成でTrueにする
# （RELEASE_PREP_NOTES.md 4.参照）。X-Forwarded-Protoヘッダを信頼するようになるため、
# プロキシ／LB以外からの直接アクセスをパケットフィルタ等で遮断済みの場合のみ有効化すること。
# 既定False。プロキシを挟まない構成（テストサーバーへの直接アクセス等）ではFalseのままにする。
# TRUST_X_FORWARDED_PROTO=True
